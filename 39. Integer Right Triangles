#include <bits/stdc++.h>
using namespace std;

int main() {
    int mx = 0, ans = 0;

    for (int p = 1; p <= 1000; p++) {
        int cnt = 0;

        for (int a = 1; a < p / 3; a++) {
            for (int b = a; b < (p - a) / 2; b++) {
                int c = p - a - b;

                if (a * a + b * b == c * c) {
                    cnt++;
                }
            }
        }

        if (cnt > mx) {
            mx = cnt;
            ans = p;
        }
    }

    cout << ans << '\n';
    return 0;
}
